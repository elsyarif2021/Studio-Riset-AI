# GEMINI_API_KEY: Required for Gemini AI API calls if used.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OLLAMA_API_KEY: API key untuk layanan Ollama Cloud (diatur di secret deployment).
OLLAMA_API_KEY="MY_OLLAMA_API_KEY"

# OLLAMA_BASE_URL: Endpoint dasar API Ollama Cloud (default: https://ollama.com/api).
OLLAMA_BASE_URL="https://ollama.com/api"

# OLLAMA_MODEL: Model default pada Ollama Cloud (nama API tanpa akhiran :cloud).
OLLAMA_MODEL="deepseek-v4.1-flash"
